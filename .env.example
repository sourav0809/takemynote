# Nothing here is needed to run the app: without these it runs in guest mode
# (notes in the browser). AI keys are added by each user in Settings → AI and
# stay in their browser.

# --- Optional: accounts, sync and sharing -----------------------------------
# All five are required to turn accounts on (see README → Run it locally).
# MongoDB connection string (Atlas, or `npm run db:dev` for a local one).
MONGODB_URI=
# Database name (default: takemynote).
MONGODB_DB=
# Random secret for sessions: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# This site's address, e.g. http://localhost:3000 or https://www.takemynote.online
BETTER_AUTH_URL=
# Google OAuth client (Web). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: profile photo uploads, stored in Vercel Blob (a *public* Blob store).
# Vercel → Storage → Create → Blob → connect to the project; this is added for you.
BLOB_READ_WRITE_TOKEN=

# --- Optional: deployment ---------------------------------------------------
# Canonical site URL for SEO and link previews (defaults to www.takemynote.online).
NEXT_PUBLIC_SITE_URL=
# Search engine ownership verification codes (the content="…" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Optional: artwork scripts ----------------------------------------------
# Only used by scripts/generate-image.mjs and scripts/generate-logo.mjs.
OPEN_AI_API_KEY=
GEMINI_API_KEY=
