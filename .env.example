# Nothing here is needed to run the app: AI keys are added by each user in
# Settings → AI and stay in their browser.

# --- Optional: deployment ---------------------------------------------------
# Canonical site URL for SEO and link previews (defaults to takemynote.vercel.app).
NEXT_PUBLIC_SITE_URL=
# Search engine ownership verification codes (the content="…" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Optional: artwork scripts ----------------------------------------------
# Only used by scripts/generate-image.mjs and scripts/generate-logo.mjs.
OPEN_AI_API_KEY=
GEMINI_API_KEY=
